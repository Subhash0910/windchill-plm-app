#!/bin/bash
WINDCHILL_HOME="$(cd "$(dirname "$0")/.." && pwd)"
JAVA_OPTS="-Xms512m -Xmx2g -Dspring.profiles.active=prod"
PID_FILE="$WINDCHILL_HOME/logs/windchill.pid"
LOG_FILE="$WINDCHILL_HOME/logs/windchill.log"
mkdir -p "$WINDCHILL_HOME/logs"

start() {
    if [ -f "$PID_FILE" ] && kill -0 $(cat "$PID_FILE") 2>/dev/null; then
        echo "Windchill is already running (PID $(cat $PID_FILE))"
        return 1
    fi
    echo "Starting Windchill PLM..."
    nohup java -jar $JAVA_OPTS \
        -Dspring.datasource.password="${DB_PASSWORD:-windchill123}" \
        -Dapp.jwtSecret="${JWT_SECRET:-windchill-dev-jwt-secret-key-please-change-this-to-a-64-bytes-minimum-value-1234567890}" \
        "$WINDCHILL_HOME/windchill-backend/backend-api/target/backend-api-1.0.0-SNAPSHOT.jar" \
        > "$LOG_FILE" 2>&1 &
    echo $! > "$PID_FILE"
    echo "Windchill started (PID $(cat $PID_FILE))"
}

stop() {
    if [ -f "$PID_FILE" ]; then
        PID=$(cat "$PID_FILE")
        if kill -0 $PID 2>/dev/null; then
            echo "Stopping Windchill (PID $PID)..."
            kill $PID
            sleep 3
            kill -9 $PID 2>/dev/null
            rm -f "$PID_FILE"
            echo "Windchill stopped."
        else
            echo "Windchill not running (stale PID file)"
            rm -f "$PID_FILE"
        fi
    else
        echo "Windchill is not running"
    fi
}

status() {
    if [ -f "$PID_FILE" ] && kill -0 $(cat "$PID_FILE") 2>/dev/null; then
        echo "Windchill is RUNNING (PID $(cat $PID_FILE))"
    else
        echo "Windchill is STOPPED"
    fi
}

case "${1:-}" in
    start)   start ;;
    stop)    stop ;;
    restart) stop; sleep 2; start ;;
    status)  status ;;
    *)       echo "Usage: windchill {start|stop|restart|status}" ;;
esac
