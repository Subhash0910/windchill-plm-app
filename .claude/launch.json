{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "frontend (Vite React)",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev", "--prefix", "windchill-frontend"],
      "port": 5173,
      "autoPort": false
    },
    {
      "name": "backend (Spring Boot)",
      "runtimeExecutable": "mvn",
      "runtimeArgs": [
        "spring-boot:run",
        "-f", "windchill-backend/pom.xml",
        "-pl", "backend-api",
        "-Dspring-boot.run.jvmArguments=-DSPRING_DATASOURCE_PASSWORD=windchill123 -DAPP_JWTSECRET=windchill-dev-jwt-secret-key-please-change-this-to-a-64-bytes-minimum-value-1234567890"
      ],
      "port": 8080,
      "autoPort": false
    },
    {
      "name": "ml-service (FastAPI)",
      "runtimeExecutable": "python",
      "runtimeArgs": ["ml-service/app.py"],
      "port": 5000,
      "autoPort": false
    }
  ]
}
