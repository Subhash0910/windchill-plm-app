# ── IDE / editors ──────────────────────────────────────────────────────
.idea/
*.iml
*.iws
*.ipr
.project
.classpath
.c9/
*.launch
.settings/
*.sublime-workspace
.history/
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json

# ── Operating system ─────────────────────────────────────────────────
.DS_Store
Thumbs.db
*.swp
*.swo
*~

# ── Secrets / environment ────────────────────────────────────────────
# Never commit .env files. Use .env.example as a template.
.env
.env.local
.env.*.local
.env.prod
.env.dev

# ── Build artefacts ─────────────────────────────────────────────────
target/
build/
dist/
out/
.gradle/
.next/
.nuxt/
.output/
.cache/

# ── Node / frontend ─────────────────────────────────────────────────
node_modules/
*.pem

# ── Logs ────────────────────────────────────────────────────────
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
spring.log

# ── Compiled / packaged artefacts ──────────────────────────────────────
*.class
*.jar
*.war
*.ear
*.zip
*.tar.gz
*.rar

# ── Database ─────────────────────────────────────────────────────
# *.sql is intentionally NOT excluded — SQL migration files must be committed.
*.db
*.sqlite
*.sqlite3

# ── Temporary files ────────────────────────────────────────────────
*.tmp
*.temp

# ── Graphify ────────────────────────────────────────────────────────
graphify-out/cache/
graphify-out/.graphify_*
.graphify_python

# ── Package manager lock files ──────────────────────────────────────
yarn.lock
pnpm-lock.yaml

# ── Maven wrapper ─────────────────────────────────────────────────
# mvnw, mvnw.cmd and .mvn/ ARE project files — they allow building without
# a local Maven installation and must be committed. Do NOT add them here.

# ── Docker local overrides (docker-compose.yml IS committed) ───────────
# .dockerignore is a project config file and must also be committed.
.docker/
docker-compose.override.yml

# ── Gradle (if added later) ────────────────────────────────────────
.gradle/
gradle-app.setting

# ── Claude Code local worktrees (never commit) ─────────────────────
.claude/worktrees/

# ── Build / dev artefacts that should not be committed ─────────────
build_log.txt
response.txt

# ── Screenshots and images captured outside the repo ──────────────
Screenshot*.png
screenshot*.png
*.screenshot.png
