# ============================================================
# PLM Learning Workspace - environment template
# ============================================================
# Copy this file to .env before running Docker Compose.
# Keep real deployment secrets out of git.
# ============================================================

# Active Spring profile.
# Use dev for local development and prod for hosted environments.
SPRING_PROFILES_ACTIVE=dev

# Database credentials used by Docker Compose.
DB_PASSWORD=change-this-local-db-password
DB_ROOT_PASSWORD=change-this-local-root-password

# Public app URL used for CORS and hosted deployments.
APP_BASE_URL=http://localhost:3000

# Generate with: openssl rand -base64 64
JWT_SECRET=replace-with-a-long-random-secret-before-any-public-deploy

# Optional email settings for notifications.
EMAIL_ENABLED=false
EMAIL_USERNAME=
EMAIL_PASSWORD=
EMAIL_FROM=noreply@example.com

# Optional file storage tuning.
FILE_STORAGE_MAX_SIZE=52428800
