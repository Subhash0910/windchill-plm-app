# =============================================================
# Windchill PLM — Environment Variables
# =============================================================
# 1. Copy this file:  cp .env.example .env
# 2. Fill in every value marked REQUIRED for your environment
# 3. NEVER commit .env to git (it is in .gitignore)
# =============================================================


# ─────────────────────────
# Spring Profile
# ─────────────────────────
# 'dev'  → Swagger enabled, verbose logging, ddl-auto=update
# 'prod' → Swagger disabled, WARN logging, ddl-auto=validate, no stack traces
SPRING_PROFILES_ACTIVE=prod


# ─────────────────────────
# Database  [REQUIRED]
# ─────────────────────────
DB_PASSWORD=change-this-strong-db-password
DB_ROOT_PASSWORD=change-this-strong-root-password


# ─────────────────────────
# JWT Security  [REQUIRED]
# ─────────────────────────
# Generate a strong secret:
#   openssl rand -base64 64
# The default in application.yml is PUBLIC — anyone who reads the
# GitHub repo can forge valid JWT tokens if you do not change this.
JWT_SECRET=change-this-to-a-very-long-random-secret-key-minimum-64-chars


# ─────────────────────────
# Application URL  [REQUIRED]
# ─────────────────────────
# The URL your frontend is accessible at.
# This is injected into the backend CORS allowed-origins list.
#
# Docker Compose on VPS:  https://yourdomain.com  (or http://YOUR_SERVER_IP:3000)
# Vercel + Railway split: https://your-app.vercel.app
APP_BASE_URL=https://yourdomain.com


# ─────────────────────────
# Email  [optional]
# ─────────────────────────
# Set EMAIL_ENABLED=true and fill in credentials to send notification emails.
# For Gmail use an App Password (not your account password).
EMAIL_ENABLED=false
EMAIL_USERNAME=your-email@gmail.com
EMAIL_PASSWORD=your-app-password
EMAIL_FROM=noreply@windchill-plm.com


# ─────────────────────────
# File Storage  [optional]
# ─────────────────────────
# Max upload size in bytes. Default is 50 MB.
FILE_STORAGE_MAX_SIZE=52428800
