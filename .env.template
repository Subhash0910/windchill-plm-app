# ============================================================
# Windchill PLM - Production Environment Template
# ============================================================
# Copy this file to .env and fill in your production secrets.
# Never commit .env to version control.
# ============================================================

# Active Spring profile (prod for production, dev for local development)
SPRING_PROFILES_ACTIVE=prod

# MySQL root password
DB_ROOT_PASSWORD=rootpassword

# MySQL application user password
DB_PASSWORD=windchill123

# JWT signing secret (generate with: openssl rand -base64 64)
JWT_SECRET=change-this-to-a-64-byte-minimum-secret-key

# Public base URL of your application (used for CORS, email links, etc.)
APP_BASE_URL=http://localhost

# Optional: File storage path inside the backend container
FILE_STORAGE_PATH=/opt/windchill/files

# Optional: File upload max size in bytes (default 50MB)
FILE_STORAGE_MAX_SIZE=52428800

# Optional: Email configuration for notifications
EMAIL_ENABLED=false
EMAIL_USERNAME=
EMAIL_PASSWORD=
EMAIL_FROM=noreply@windchill-plm.com

# Optional: JPA DDL auto (validate is safe for production, update for dev)
JPA_DDL_AUTO=validate
